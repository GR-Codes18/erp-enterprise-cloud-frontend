# Copia este archivo como ".env" y ajusta los valores. El archivo ".env" NO se sube a Git.
#
# Todo lo que empieza con VITE_ se incluye en el código que llega al navegador:
# nunca pongas aquí contraseñas, tokens ni claves secretas.

# URL base de la API del backend (incluye /api/v1, sin barra final)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# true  = datos simulados con MSW (solo funciona en desarrollo)
# false = backend real
VITE_ENABLE_MOCKS=true
